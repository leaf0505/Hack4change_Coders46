@{
    ViewData["Title"] = "Dashboard";
    var org       = ViewBag.Org       as mvc_final_final.Models.Organisation;
    var needs     = ViewBag.Needs     as List<mvc_final_final.Models.Need>             ?? new();
    var proposals = ViewBag.Proposals as List<mvc_final_final.Models.TransferProposal> ?? new();
    var donations = ViewBag.Donations as List<mvc_final_final.Models.Donation>         ?? new();
}
<style>
    .dash { display: grid; grid-template-columns: 210px 1fr; min-height: calc(100vh - 64px); }
    .sidebar { background: #fff; border-right: 2px solid #E8EEF3; padding: 18px 12px; display: flex; flex-direction: column; gap: 2px; }
    .sidebar-org { padding: 8px 10px 16px; border-bottom: 2px solid #E8EEF3; margin-bottom: 8px; }
    .sidebar-org-name { font-size: 14px; font-weight: 700; color: #1F2937; font-family: Georgia, serif; }
    .sidebar-org-email { font-size: 12px; color: #9CA3AF; margin-top: 2px; }
    .nav-section { font-size: 11px; font-weight: 700; color: #9CA3AF; text-transform: uppercase; letter-spacing: 0.08em; padding: 10px 10px 4px; }
    .nav-item { display: flex; align-items: center; gap: 9px; padding: 10px 10px; border-radius: 7px; font-size: 14px; color: #4A5568; cursor: pointer; text-decoration: none; transition: all .12s; font-weight: 600; }
    .nav-item:hover { background: #F0F5FB; color: #2C5F8A; }
    .nav-item.active { background: #EBF2F9; color: #2C5F8A; }
    .sidebar-footer { margin-top: auto; border-top: 2px solid #E8EEF3; padding-top: 10px; }

    .dash-main { background: #FAFAF8; padding: 26px; overflow-y: auto; }
    .dash-topbar { display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 22px; }
    .dash-title { font-size: 22px; font-weight: 700; color: #1F2937; font-family: Georgia, serif; }
    .dash-date  { font-size: 13px; color: #9CA3AF; margin-top: 3px; }
    .dash-actions { display: flex; gap: 8px; }

    .stats-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 12px; margin-bottom: 20px; }

    .proposal-alert { background: #FFFBEB; border: 2px solid #FDE68A; border-radius: 12px; padding: 16px 20px; margin-bottom: 20px; }
    .proposal-alert-title { font-size: 15px; font-weight: 700; color: #92400E; margin-bottom: 10px; font-family: Georgia, serif; display: flex; align-items: center; gap: 8px; }
    .proposal-item { display: flex; align-items: center; justify-content: space-between; padding: 10px 0; border-top: 1px solid #FDE68A; gap: 10px; flex-wrap: wrap; }
    .proposal-desc { font-size: 14px; color: #78350F; font-weight: 500; }
    .proposal-btns { display: flex; gap: 8px; flex-shrink: 0; }
    .btn-accept  { padding: 8px 16px; background: #059669; border: none; color: #fff; border-radius: 7px; font-size: 13px; font-weight: 700; cursor: pointer; font-family: Georgia, serif; }
    .btn-accept:hover { background: #047857; }
    .btn-decline-sm { padding: 8px 16px; background: transparent; border: 2px solid #FDE68A; color: #92400E; border-radius: 7px; font-size: 13px; font-weight: 600; cursor: pointer; }

    .dash-grid { display: grid; grid-template-columns: 1fr 340px; gap: 16px; }

    .need-row-item { display: flex; align-items: center; gap: 13px; padding: 15px 18px; border-bottom: 1px solid #F3F4F6; }
    .need-row-item:last-child { border-bottom: none; }
    .need-row-icon { width: 40px; height: 40px; border-radius: 9px; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0; }
    .need-row-info { flex: 1; min-width: 0; }
    .need-row-name { font-size: 14px; font-weight: 700; color: #1F2937; font-family: Georgia, serif; }
    .need-row-meta { font-size: 12px; color: #9CA3AF; margin-top: 2px; }
    .need-row-right { flex-shrink: 0; text-align: right; }
    .need-row-pct { font-size: 12px; color: #9CA3AF; margin-bottom: 5px; font-weight: 600; }
    .need-row-bar { width: 110px; height: 7px; background: #F3F4F6; border-radius: 4px; overflow: hidden; }
    .need-row-fill { height: 100%; border-radius: 4px; }
    .need-row-fill.crit { background: #DC2626; }
    .need-row-fill.med  { background: #D97706; }
    .need-row-fill.good { background: #059669; }

    .don-item { display: flex; align-items: center; gap: 10px; padding: 13px 16px; border-bottom: 1px solid #F3F4F6; }
    .don-item:last-child { border-bottom: none; }
    .don-avatar { width: 36px; height: 36px; border-radius: 50%; background: #EBF2F9; color: #2C5F8A; font-size: 12px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .don-info { flex: 1; }
    .don-name { font-size: 14px; font-weight: 700; color: #1F2937; }
    .don-need { font-size: 12px; color: #9CA3AF; }
    .don-time { font-size: 11px; color: #D1D5DB; margin-top: 1px; }
    .don-qty  { font-size: 14px; font-weight: 700; color: #2C5F8A; white-space: nowrap; }
    .empty-dash { padding: 24px; text-align: center; color: #9CA3AF; font-size: 14px; }
</style>

<div class="dash">
    <div class="sidebar">
        <div class="sidebar-org">
            <div class="sidebar-org-name">@(org?.Name ?? "Organisation")</div>
            <div class="sidebar-org-email">@User.Identity?.Name</div>
        </div>
        <span class="nav-section">Menu</span>
        <a class="nav-item active" asp-action="Dashboard">
            <svg width="15" height="15" viewBox="0 0 15 15" fill="none"><rect x="1" y="1" width="6" height="6" rx="1.5" stroke="currentColor" stroke-width="1.3"/><rect x="1" y="9" width="6" height="5" rx="1.5" stroke="currentColor" stroke-width="1.3"/><rect x="9" y="1" width="5" height="6" rx="1.5" stroke="currentColor" stroke-width="1.3"/><rect x="9" y="9" width="5" height="5" rx="1.5" stroke="currentColor" stroke-width="1.3"/></svg>
            Dashboard
        </a>
        <a class="nav-item" asp-action="CreateNeed">
            <svg width="15" height="15" viewBox="0 0 15 15" fill="none"><path d="M7.5 2v11M2 7.5h11" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
            Add a need
        </a>
        <a class="nav-item" asp-action="ImportExcel">
            <svg width="15" height="15" viewBox="0 0 15 15" fill="none"><path d="M3 2h6l3 3v8a1 1 0 01-1 1H3a1 1 0 01-1-1V3a1 1 0 011-1z" stroke="currentColor" stroke-width="1.2"/><path d="M9 2v3h3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/><path d="M5 8l2 2 3-3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Import Excel
        </a>
        <div class="sidebar-footer">
            <form asp-controller="Account" asp-action="Logout" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="nav-item" style="width:100%;border:none;background:transparent;cursor:pointer;font-family:inherit">
                    <svg width="15" height="15" viewBox="0 0 15 15" fill="none"><path d="M6 13H3a1 1 0 01-1-1V3a1 1 0 011-1h3M10 10l3-3-3-3M13 7H5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    Sign out
                </button>
            </form>
        </div>
    </div>

    <div class="dash-main">
        <div class="dash-topbar">
            <div>
                <div class="dash-title">Dashboard</div>
                <div class="dash-date">@DateTime.Now.ToString("dddd, MMMM d, yyyy")</div>
            </div>
            <div class="dash-actions">
                <a class="btn-app outline" asp-action="ImportExcel">Import Excel</a>
                <a class="btn-app primary" asp-action="CreateNeed">+ Add need</a>
            </div>
        </div>

        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-card-label">Active needs</div>
                <div class="stat-card-value">@needs.Count</div>
                <div class="stat-card-sub">@needs.Count(n => n.Priority == mvc_final_final.Models.Priority.Critical && !n.IsComplete) critical pending</div>
            </div>
            <div class="stat-card">
                <div class="stat-card-label">Completed</div>
                <div class="stat-card-value">@needs.Count(n => n.IsComplete)</div>
                <div class="stat-card-sub">Out of @needs.Count total</div>
            </div>
            <div class="stat-card">
                <div class="stat-card-label">Donations received</div>
                <div class="stat-card-value">@donations.Count</div>
                <div class="stat-card-sub">@donations.Select(d => d.GuestDonorId).Distinct().Count() unique donors</div>
            </div>
            <div class="stat-card">
                <div class="stat-card-label">Surplus proposals</div>
                <div class="stat-card-value">@proposals.Count</div>
                <div class="stat-card-sub">@(proposals.Any() ? "Awaiting your response" : "None pending")</div>
            </div>
        </div>

        @if (proposals.Any())
        {
            <div class="proposal-alert">
                <div class="proposal-alert-title">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 2L9.8 6.2H14.5L10.8 8.9L12.2 13.5L8 10.9L3.8 13.5L5.2 8.9L1.5 6.2H6.2L8 2Z" fill="#D97706"/></svg>
                    @proposals.Count surplus proposal(s) awaiting your response
                </div>
                @foreach (var p in proposals)
                {
                    <div class="proposal-item">
                        <span class="proposal-desc">
                            <strong>@p.Surplus?.Quantity × @p.Surplus?.Need?.ItemName</strong>
                            offered from @p.Surplus?.Need?.Organisation?.Name
                        </span>
                        <div class="proposal-btns">
                            <form asp-action="Accept" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="proposalId" value="@p.Id" />
                                <button type="submit" class="btn-accept">✓ Accept</button>
                            </form>
                            <form asp-action="Decline" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="proposalId" value="@p.Id" />
                                <button type="submit" class="btn-decline-sm">Decline</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }

        <div class="dash-grid">
            <div class="card-app">
                <div class="card-app-header">
                    <span class="card-app-title">My needs</span>
                    <a class="btn-app outline" style="padding:6px 14px;font-size:13px" asp-action="CreateNeed">+ Add</a>
                </div>
                @if (!needs.Any())
                {
                    <div class="empty-dash">No needs yet. <a asp-action="CreateNeed" style="color:#2C5F8A;font-weight:700">Add your first need</a> or <a asp-action="ImportExcel" style="color:#2C5F8A;font-weight:700">import from Excel</a>.</div>
                }
                else
                {
                    @foreach (var need in needs)
                    {
                        string nIcon, nIconBg, nBarFill, nPrioClass;
                        if (need.Category == "food")          { nIcon = "🥫"; nIconBg = "#FEF3C7"; }
                        else if (need.Category == "clothing") { nIcon = "🧥"; nIconBg = "#DBEAFE"; }
                        else if (need.Category == "hygiene")  { nIcon = "🧼"; nIconBg = "#D1FAE5"; }
                        else if (need.Category == "bedding")  { nIcon = "🛏️"; nIconBg = "#EDE9FE"; }
                        else                                  { nIcon = "📦"; nIconBg = "#F3F4F6"; }
                        if (need.CompletionPercent < 35)      nBarFill = "crit";
                        else if (need.CompletionPercent < 70) nBarFill = "med";
                        else                                  nBarFill = "good";
                        if (need.Priority == mvc_final_final.Models.Priority.Critical) nPrioClass = "critical";
                        else if (need.Priority == mvc_final_final.Models.Priority.Normal) nPrioClass = "normal";
                        else nPrioClass = "low";

                        <div class="need-row-item">
                            <div class="need-row-icon" style="background:@nIconBg">@nIcon</div>
                            <div class="need-row-info">
                                <div class="need-row-name">@need.ItemName</div>
                                <div class="need-row-meta">
                                    <span class="prio @nPrioClass" style="font-size:10px;padding:2px 8px">@need.Priority</span>
                                    · @need.Category
                                </div>
                            </div>
                            <div class="need-row-right">
                                <div class="need-row-pct">@need.QuantityReceived / @need.QuantityNeeded</div>
                                <div class="need-row-bar"><div class="need-row-fill @nBarFill" style="width:@(need.CompletionPercent)%"></div></div>
                            </div>
                            <form asp-action="DeleteNeed" asp-route-id="@need.Id" method="post" class="d-inline" onsubmit="return confirm('Archive this need?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-app danger">🗑️</button>
                            </form>
                        </div>
                    }
                }
            </div>

            <div class="card-app">
                <div class="card-app-header">
                    <span class="card-app-title">Recent donations</span>
                </div>
                @if (!donations.Any())
                {
                    <div class="empty-dash">No donations received yet.</div>
                }
                else
                {
                    @foreach (var d in donations)
                    {
                        var initials = string.Join("", ((d.GuestDonor != null ? d.GuestDonor.FullName : "?")).Split(' ').Take(2).Select(w => w.Length > 0 ? w[0].ToString().ToUpper() : ""));
                        <div class="don-item">
                            <div class="don-avatar">@initials</div>
                            <div class="don-info">
                                <div class="don-name">@(d.GuestDonor != null ? d.GuestDonor.FullName : "Unknown")</div>
                                <div class="don-need">@(d.Need != null ? d.Need.ItemName : "")</div>
                                <div class="don-time">@d.DonatedAt.ToString("MMM d, yyyy · HH:mm")</div>
                            </div>
                            <div class="don-qty">× @d.Quantity</div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>
