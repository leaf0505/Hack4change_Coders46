@model mvc_final_final.Models.Need
@{
    ViewData["Title"] = "Add a Need";
    var categories = new[] { "food", "clothing", "hygiene", "bedding", "beds", "other" };
}
<div style="max-width:520px;margin:0 auto;padding:28px 20px 48px">
    <a class="btn-app outline" asp-action="Dashboard" style="margin-bottom:20px;display:inline-flex">← Back to dashboard</a>
    <div class="card-app">
        <div class="card-app-header"><span class="card-app-title">Add a new need</span></div>
        <div style="padding:24px">
            <form asp-action="CreateNeed" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="app-alert error" style="display:@(ViewContext.ModelState.IsValid ? "none" : "block");margin-bottom:16px"></div>
                <div class="form-group-app">
                    <label asp-for="ItemName" class="form-label-app"></label>
                    <input asp-for="ItemName" class="form-control-app" placeholder="e.g. Winter coats, canned goods..." autofocus />
                    <span asp-validation-for="ItemName" class="form-hint-app" style="color:#DC2626"></span>
                </div>
                <div class="form-group-app">
                    <label asp-for="Category" class="form-label-app"></label>
                    <select asp-for="Category" class="form-control-app">
                        @foreach (var cat in categories) { <option value="@cat">@cat</option> }
                    </select>
                </div>
                <div class="form-group-app">
                    <label asp-for="QuantityNeeded" class="form-label-app"></label>
                    <input asp-for="QuantityNeeded" type="number" min="1" class="form-control-app" />
                    <span asp-validation-for="QuantityNeeded" class="form-hint-app" style="color:#DC2626"></span>
                </div>
                <div class="form-group-app">
                    <label asp-for="Priority" class="form-label-app"></label>
                    <select asp-for="Priority" class="form-control-app">
                        <option value="0">Critical — urgent need</option>
                        <option value="1" selected>Normal</option>
                        <option value="2">Low priority</option>
                    </select>
                </div>
                <div style="display:flex;justify-content:space-between;margin-top:24px">
                    <a class="btn-app outline" asp-action="Dashboard">Cancel</a>
                    <button type="submit" class="btn-app primary">Create need →</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
}
