@{ ViewData["Title"] = "Organisation Login"; }
<div style="min-height:calc(100vh - 112px);display:flex;align-items:center;justify-content:center;padding:20px;background:#FAFAF8">
    <div style="width:100%;max-width:400px">
        <div style="text-align:center;margin-bottom:28px">
            <div style="width:54px;height:54px;background:#2C5F8A;border-radius:12px;display:flex;align-items:center;justify-content:center;margin:0 auto 14px">
                <svg width="26" height="26" viewBox="0 0 26 26" fill="none"><path d="M13 3L15.8 9.5H23L17.3 13.8L19.5 21L13 17.3L6.5 21L8.7 13.8L3 9.5H10.2L13 3Z" fill="white"/></svg>
            </div>
            <h1 style="font-size:24px;font-weight:700;color:#1F2937;margin-bottom:6px;font-family:Georgia,serif">Organisation portal</h1>
            <p style="font-size:15px;color:#9CA3AF">Sign in to manage your needs and donations</p>
        </div>
        <div class="card-app">
            <div style="padding:26px">
                @if (!ViewContext.ModelState.IsValid) { <div class="app-alert error" style="margin-bottom:16px"><div asp-validation-summary="All"></div></div> }
                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <div class="form-group-app">
                        <label class="form-label-app">Email address</label>
                        <input type="email" name="email" class="form-control-app" placeholder="org@example.com" autofocus required />
                    </div>
                    <div class="form-group-app">
                        <label class="form-label-app">Password</label>
                        <input type="password" name="password" class="form-control-app" placeholder="Your password" required />
                    </div>
                    <button type="submit" class="btn-app primary" style="width:100%;justify-content:center;padding:14px;font-size:16px;margin-top:8px">Sign in →</button>
                </form>
                <div style="text-align:center;margin-top:20px;padding-top:16px;border-top:1px solid #F3F4F6">
                    <p style="font-size:14px;color:#9CA3AF;margin-bottom:6px">No account yet?</p>
                    <a asp-action="Register" style="font-size:15px;color:#2C5F8A;font-weight:700;text-decoration:none">Create organisation account →</a>
                </div>
                <div style="text-align:center;margin-top:16px;padding:12px;background:#F9FAFB;border-radius:8px;border:1px solid #E8EEF3">
                    <p style="font-size:13px;color:#9CA3AF;margin:0">Demo: <code>org@demo.com</code> / <code>demo123</code></p>
                </div>
            </div>
        </div>
        <div style="text-align:center;margin-top:16px">
            <a asp-controller="Donor" asp-action="Index" style="font-size:14px;color:#9CA3AF;text-decoration:none">← Back to public needs</a>
        </div>
    </div>
</div>
